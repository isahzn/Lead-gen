# Copy to .env (or use the Settings page). Never commit .env.
SMTP_MODE=dry          # dry = never really sends. Set to live to send.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=             # Gmail/Outlook need an APP PASSWORD
SMTP_FROM=
SMTP_SECURE=starttls   # starttls | ssl
SENDER_NAME=Hassen
DAILY_LIMIT=10
BRAVE_API_KEY=         # free tier: https://brave.com/search/api/
LAYA_ENABLED=0         # 1 = use Laya for service recommendation (needs torch + HF model download)
GOOGLE_PLACES_KEY=     # official Google Places API key (optional)
FOLLOWUP_DAYS=5        # days after last email before a follow-up is suggested
MAX_FOLLOWUPS=1
