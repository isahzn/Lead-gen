# Copy to .env (or use the Settings page). Never commit .env.
SMTP_MODE=dry          # dry = never really sends. Set to live to send.
SMTP_HOST=smtp.gmail.com   # pre-filled for Gmail — leave as is
SMTP_PORT=587              # pre-filled for Gmail — leave as is
SMTP_USER=             # YOUR Gmail address (the only address you must type)
SMTP_PASS=             # YOUR Gmail APP PASSWORD (Google Account > Security > 2-Step Verification > App passwords)
SMTP_FROM=             # blank = same as SMTP_USER (leave blank)
SMTP_SECURE=starttls   # pre-filled for Gmail: starttls | ssl
SENDER_NAME=Hassen
DAILY_LIMIT=10
PLAYWRIGHT_MCP_CLI=    # blank = auto-detect Playwright MCP (no search API key needed)
LAYA_ENABLED=0         # 1 = use Laya for service recommendation (needs torch + HF model download)
FOLLOWUP_DAYS=5        # days after last email before a follow-up is suggested
MAX_FOLLOWUPS=1
